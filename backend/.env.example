PORT=3000
HOST=127.0.0.1
# Local demo (ignored when DATABASE_URL is configured)
DATABASE_PATH=./data/brickwell.sqlite
# Supabase Session Pooler: private backend-only URL, never VITE_DATABASE_URL.
# DATABASE_URL=postgresql://brickwell_backend.PROJECT_REF:PRIVATE_PASSWORD@POOLER_HOST:5432/postgres
# DATABASE_CA_CERT is optional; the official Supabase CA is included in certs/.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://garypoui.github.io
# Complete both variables to provision an administrator on first startup.
# ADMIN_EMAIL=tu-email@example.com
# ADMIN_PASSWORD=Elegir-una-clave-privada-123
# RECEPCION_EMAIL=recepcion@example.com
# RECEPCION_PASSWORD=Elegir-otra-clave-privada-123
