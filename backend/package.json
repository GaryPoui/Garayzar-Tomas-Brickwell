{
  "name": "brickells-backend",
  "version": "1.0.0",
  "description": "API REST de Brickell's organizada con patrón MVC",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "demo": "node scripts/demo.js",
    "test": "node --test test/*.test.js",
    "test:cloud": "node --env-file-if-exists=.env --test test/cloud.integration.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "pg": "8.23.1"
  }
}
